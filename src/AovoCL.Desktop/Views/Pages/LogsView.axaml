<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AovoCL.Desktop.Views.Pages.LogsView">

  <Grid RowDefinitions="Auto,*" Margin="20,16">

    <!-- 工具栏 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="运行日志" Classes="h2" VerticalAlignment="Center" />
      <CheckBox Grid.Column="2" Content="自动滚动" FontSize="12" Margin="0,0,14,0"
                VerticalAlignment="Center" IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
      <Button Grid.Column="3" Classes="ghost" Content="清空" Command="{Binding ClearCommand}"
              VerticalAlignment="Center" />
    </Grid>

    <!-- 日志内容 -->
    <Border Grid.Row="1" Classes="card" Padding="14" CornerRadius="14">
      <ScrollViewer x:Name="LogScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Log.Text}"
                   FontFamily="{DynamicResource MonoFontFamily}"
                   FontSize="11.5"
                   TextWrapping="NoWrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
